HYPIXEL_API_KEY=
OPENAI_API_KEY=

# Future account infrastructure (not yet wired into the application).
# Match compose.yaml for local PostgreSQL; never use this password in production.
DATABASE_URL=postgresql://statixel:statixel_local_only@127.0.0.1:5432/statixel
# Generate a unique secret before enabling Better Auth.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional overrides; defaults are data/neu and data/market/latest.json.
# NEU_DATA_DIRECTORY=C:\path\to\neu
# MARKET_SNAPSHOT_PATH=C:\path\to\market\latest.json
