HYPIXEL_API_KEY=
OPENAI_API_KEY=

# Local PostgreSQL only; credentials are public development examples, never production secrets.
DATABASE_URL=postgresql://statixel:statixel_local_only@127.0.0.1:5433/statixel
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Email transport (Resend testing sender is not for public registration).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional until Turnstile is configured. Public registration remains disabled.
# Keep the secret server-side; the site key is public and used by the future signup UI.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional overrides; defaults are data/neu and data/market/latest.json.
# NEU_DATA_DIRECTORY=C:\path\to\neu
# MARKET_SNAPSHOT_PATH=C:\path\to\market\latest.json
