HYPIXEL_API_KEY=
OPENAI_API_KEY=

# Local PostgreSQL only; credentials are public development examples, never production secrets.
DATABASE_URL=postgresql://statixel:statixel_local_only@127.0.0.1:5433/statixel
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional account email sender. Registration stays disabled until delivery
# and abuse prevention have been tested and a sending domain is verified.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional overrides; defaults are data/neu and data/market/latest.json.
# NEU_DATA_DIRECTORY=C:\path\to\neu
# MARKET_SNAPSHOT_PATH=C:\path\to\market\latest.json
